# Fonts
# font_family      JetBrains Mono
# bold_font        auto
# italic_font      auto
# bold_italic_font auto
font_size        12.0

# Window Layout & Padding
window_padding_width 15
placement_strategy   center
hide_window_decorations yes

# Transparency (0.0 is fully transparent, 1.0 is solid)
background_opacity 0.85

# Clean, modern Tab Bar
tab_bar_style       powerline
tab_powerline_style slanted
tab_bar_edge        top

include wallust.conf


# BEGIN_KITTY_FONTS
font_family      family="FiraCode Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS